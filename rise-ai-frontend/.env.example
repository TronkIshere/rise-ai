# Vite development only. Leave unset to use Vite dev proxy to Backend :8080.
# Set this to an explicitly configured Backend origin when running Vite separately.
VITE_API_BASE_URL=

# FE-06 local Docker/Nginx staging uses same-origin /api reverse proxy,
# so VITE_API_BASE_URL is forced empty at Docker BUILD time.
# Set these only in your shell/PowerShell (no secrets in frontend source).
# RISE_FRONTEND_BACKEND_UPSTREAM=http://host.docker.internal:18082
# RISE_FRONTEND_HTTP_PORT=5174
# RISE_FE06_BASE_URL=http://127.0.0.1:5174
# RISE_FE06_TARGET=docker
