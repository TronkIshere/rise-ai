# Copy to .env (git-ignored) and replace every value. Local Docker Compose only; these are not production secrets.
RISE_DB_PASSWORD=change-me-db
RISE_DB_ROOT_PASSWORD=change-me-db-root
# At least 32 characters; the prod profile refuses the development default.
RISE_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
RISE_MONITORING_SERVICE_KEY=change-me-monitoring-key
RISE_AVALANCHE_INTERNAL_API_KEY=change-me-gateway-key

# Demo data for local testing. The prod profile refuses the default demo password and needs simulation on when seeding.
RISE_SEED_ENABLED=true
RISE_SIMULATION_ENABLED=true
RISE_DEMO_PASSWORD=change-me-Demo1!

# avalanche (default): escrow mirrored on the local Anvil chain. simulated: MySQL ledger only.
# RISE_ESCROW_ENGINE=simulated
